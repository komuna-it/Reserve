# Environment
SPRING_PROFILES_ACTIVE=beta

# PostgreSQL
POSTGRES_DB=reserve
POSTGRES_USER=reserve
POSTGRES_PASSWORD=your-beta-database-password

# Spring datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/reserve
SPRING_DATASOURCE_USERNAME=reserve
SPRING_DATASOURCE_PASSWORD=your-beta-database-password

# JWT
RESERVE_TOKENS_SECRET=your-beta-token-secret

# JVM
JAVA_TOOL_OPTIONS=-XX:+UnlockDiagnosticVMOptions -XX:-UseBASE64Intrinsics